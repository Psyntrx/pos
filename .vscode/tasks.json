{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Debug APK",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": [
        "assembleDebug",
        "--console",
        "plain"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Unit Tests",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": [
        "testDebugUnitTest",
        "--console",
        "plain"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Verify Auth and Product Tests (Robolectric)",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": [
        "testDebugUnitTest",
        "--tests",
        "com.example.pos.AuthViewModelTest",
        "--tests",
        "com.example.pos.PosViewModelProductTest",
        "--console",
        "plain"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Clean Build",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": [
        "clean",
        "assembleDebug",
        "--console",
        "plain"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Install Debug APK",
      "type": "shell",
      "command": "adb",
      "args": [
        "install",
        "-r",
        "${workspaceFolder}\\app\\build\\outputs\\apk\\debug\\app-debug.apk"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Git Status",
      "type": "shell",
      "command": "git",
      "args": [
        "status",
        "--short",
        "--branch"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Git Diff Check",
      "type": "shell",
      "command": "git",
      "args": [
        "diff",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Git Staged Diff Check",
      "type": "shell",
      "command": "git",
      "args": [
        "diff",
        "--cached",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Git Remote + Fetch Check",
      "type": "shell",
      "command": "git",
      "args": [
        "fetch",
        "--all",
        "--prune"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}